# Copy this file to  .env  (same folder) and fill in what you have. Everything is optional.

# --- Admin panel login (user is always "admin") ---
ADMIN_PASSWORD=change-me

# --- Redis (hot layer: live view, counters). Free cloud Redis works, e.g.:
#     rediss://default:YOUR_PASSWORD@your-host.example.com:6379
REDIS_URL=

# --- Firestore (durable archive). Put your Firebase service-account key in api/secrets/
FIRESTORE_ENABLED=0
GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-key.json
# FIREBASE_PROJECT_ID=your-project-id

# --- Recognition tuning (optional) ---
# WORD_VOCAB=reliable      # reliable = 16 best words, all = 100 words
# WORD_MIN_CONF=0.50
# SENTENCE_GAP_SECONDS=2.5
